# ── 데이터베이스 (Neon PostgreSQL) ──────────────────────────
# Neon 대시보드 > Connection string 에서 복사한다.
# DATABASE_URL 은 풀링 주소(-pooler 가 붙은 것), DIRECT_URL 은 직결 주소를 쓴다.
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require"

# ── NextAuth ────────────────────────────────────────────────
# 아래 명령으로 새로 만들어서 넣는다. 절대 예시 값을 그대로 쓰지 않는다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="여기에_생성한_랜덤_문자열"

# 로컬은 http://localhost:3000, 배포 후에는 실제 주소(https://xxx.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# ── seed 실행 시에만 사용 ───────────────────────────────────
# 관리자 계정 비밀번호. 10자 이상. 커밋되지 않으니 여기에 적어도 되지만
# 되도록 실행할 때 한 번만 넘기는 편이 낫다.
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD=""
