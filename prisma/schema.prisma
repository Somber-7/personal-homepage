generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

// 관리자 로그인 시도 기록. 아이디·IP별로 짧은 시간 안에 여러 번 실패하면 잠시 막는다(lib/login-limit.ts)
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  key       String // "user:아이디" 또는 "ip:주소"
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Experience {
  id        Int      @id @default(autoincrement())
  period    String
  duration  String
  company   String
  role      String
  desc      String   @db.Text
  tags      String   @db.Text
  isCurrent Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Education {
  id        Int      @id @default(autoincrement())
  period    String
  duration  String
  name      String
  course    String
  desc      String   @db.Text
  tags      String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id        Int      @id @default(autoincrement())
  title     String
  client    String
  org       String   @default("")
  period    String
  desc      String   @db.Text
  // 상세 페이지 칸. 한 줄에 하나씩, "라벨: 내용"으로 쓰면 라벨이 굵게 나온다. 비운 칸은 상세 페이지에 나오지 않는다
  work      String   @default("") @db.Text // 맡은 일
  solution  String   @default("") @db.Text // 구현과 문제 해결
  result    String   @default("") @db.Text // 결과
  role      String
  image     String?
  link      String?
  repo      String? // 공개 저장소 주소. 있으면 상세 페이지에 '코드 보기' 버튼
  tags      String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id         Int     @id @default(autoincrement())
  category   String
  items      String  @db.Text
  isLearning Boolean @default(false)
  order      Int     @default(0)
}

model Certification {
  id    Int    @id @default(autoincrement())
  name  String
  org   String
  year  String
  order Int    @default(0)
}
